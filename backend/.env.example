# Supabase PostgreSQL Configuration
# DO NOT put real passwords or secrets in this example file.
# Copy this file to .env and fill in your actual values.

# Database Connection (Direct Connection)
DB_HOST=db.peozkhpdwvrctmqroqau.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=change-this-to-your-supabase-db-password
DB_SSLMODE=require

# Alternative: Session Pooler (use if your network is IPv4-only and direct connection fails)
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.peozkhpdwvrctmqroqau
# DB_PASSWORD=change-this-to-your-supabase-db-password
# DB_SSLMODE=require

# Supabase Project Details
SUPABASE_PROJECT_REF=peozkhpdwvrctmqroqau
SUPABASE_URL=https://peozkhpdwvrctmqroqau.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Security & Authentication (JWT)
JWT_SECRET=replace-with-a-secure-random-256-bit-key-for-production
JWT_EXPIRATION_MS=86400000
AUTH_VERIFICATION_TOKEN_EXPIRY_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Reputation Configuration
REPUTATION_ENABLED=true
REPUTATION_DEFAULT_HANDOVER_POINTS=10
REPUTATION_DEFAULT_COLLECTION_POINTS=0
